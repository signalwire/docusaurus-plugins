{
  "name": "@signalwire/docusaurus-theme-llms-txt",
  "version": "1.0.0-alpha.9",
  "description": "Docusaurus theme components for the llms-txt plugin, including CopyPageContent",
  "main": "./lib/index.js",
  "types": "src/theme-llms-txt.d.ts",
  "exports": {
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./lib/hooks/index.js"
    },
    "./react-icons": {
      "types": "./src/reactIcons.ts",
      "default": "./lib/reactIcons.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./lib/types.js"
    },
    ".": {
      "types": "./src/theme-llms-txt.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src/hooks/index.ts",
    "src/hooks/useCopyActions.ts",
    "src/hooks/useCopyButtonConfig.ts",
    "src/hooks/useCopyContentData.ts",
    "src/hooks/useDropdownState.ts",
    "src/reactIcons.ts",
    "src/theme",
    "src/theme-llms-txt.d.ts",
    "src/types",
    "src/types.ts",
    "src/utils",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build && node ../../scripts/copyUntypedFiles.js && prettier --config ../../.prettierrc.json --write \"lib/theme/**/*.js\"",
    "build:watch": "tsc --build --watch",
    "copy:watch": "node ../../scripts/copyUntypedFiles.js --watch",
    "watch": "concurrently --names \"tsc,copy\" --kill-others \"pnpm run build:watch\" \"pnpm run copy:watch\"",
    "clean": "rimraf lib .tsbuildinfo",
    "lint": "echo 'Linting handled at root level'",
    "lint:fix": "echo 'Linting handled at root level'",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run lint && pnpm run type-check"
  },
  "keywords": [
    "signalwire",
    "docusaurus",
    "theme",
    "llms-txt",
    "copy-button",
    "ai",
    "llm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "react-icons": "^5.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^9.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/theme-common": "^3.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "author": "SignalWire <devon.white@signalwire.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/signalwire/docusaurus-plugins.git",
    "directory": "packages/docusaurus-theme-llms-txt"
  },
  "homepage": "https://github.com/signalwire/docusaurus-plugins/tree/main/packages/docusaurus-theme-llms-txt#readme",
  "bugs": {
    "url": "https://github.com/signalwire/docusaurus-plugins/issues"
  }
}
