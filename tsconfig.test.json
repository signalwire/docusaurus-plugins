{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // tsconfig.base.json sets "rootDir": "${configDir}/src" for the packages.
    // Inheriting that here points at a nonexistent <repo>/src and makes
    // `tsc -p tsconfig.test.json` fail with TS6059 before it reports a single
    // real error. The test tree spans the repo root, so the root is the rootDir.
    "rootDir": ".",
    // module-type-aliases supplies the *.module.css declarations the theme
    // sources import; without it every styles import is a TS2307.
    "types": ["node", "jest", "@testing-library/jest-dom", "@docusaurus/module-type-aliases"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@test/*": ["./test/*"],
      "@theme/*": ["./packages/docusaurus-theme-llms-txt/src/theme/*"],
      "@docusaurus/router": ["./test/mocks/docusaurus/router"],
      "@docusaurus/ExecutionEnvironment": ["./test/mocks/docusaurus/ExecutionEnvironment"],
      "@docusaurus/useBaseUrl": ["./test/mocks/docusaurus/useBaseUrl"],
      "@docusaurus/useGlobalData": ["./test/mocks/docusaurus/useGlobalData"],
      "@docusaurus/Translate": ["./test/mocks/docusaurus/Translate"],
      "@docusaurus/theme-common": ["./test/mocks/docusaurus/theme-common"]
    }
  },
  "include": ["__tests__/**/*", "test/**/*", "packages/*/**/__tests__/**/*"],
  "exclude": ["node_modules", "**/lib/**"]
}
